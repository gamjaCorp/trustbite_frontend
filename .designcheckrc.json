{
  "include": [
    "src/app/page.tsx",
    "src/app/layout.tsx",
    "src/components/core/**/*.tsx",
    "src/components/features/ranking/**/*.tsx",
    "src/components/features/explore/**/*.tsx",
    "src/lib/category.ts"
  ],
  "exclude": [
    "src/components/features/explore/restaurant-pin.tsx"
  ],
  "rules": {
    "no-raw-color": {
      "enabled": true,
      "description": "raw hex(#rgb/#rrggbb/#rrggbbaa)·rgb()/rgba() 사용 금지. globals.css palette 토큰 사용."
    }
  }
}
